---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ScrollFX from '../components/ScrollFX.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
}
const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
  canonicalUrl = site.url,
  ogType = 'website',
} = Astro.props;
const sameAs = site.socials.map((s) => s.href).filter((h) => h !== '#');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description: site.description,
    },
    {
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      url: site.url,
      description: site.description,
      sameAs,
    },
    {
      '@type': 'ProfessionalService',
      name: `${site.name} — ${site.role}`,
      url: site.url,
      email: `mailto:${site.email}`,
      description: site.description,
      areaServed: 'Worldwide',
      serviceType: site.services.map((s) => s.title),
      provider: { '@type': 'Person', name: site.name },
      sameAs,
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Rabia Gul — Blog" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://cdn.simpleicons.org" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="font-sans antialiased">
    <!-- Without JS the preloader can't remove itself, so never show it. -->
    <noscript><style>#preloader{display:none!important}</style></noscript>
    <!-- Without JS Framer Motion SSRs opacity:0 — make reveals visible. -->
    <noscript><style>[data-framer-reveal]{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
    <!-- Site preloader: shows once per session, wipes up to reveal the page -->
    <div id="preloader" aria-hidden="true">
      <div class="pl-fx" aria-hidden="true">
        <div class="pl-orb pl-orb-a"></div>
        <div class="pl-orb pl-orb-b"></div>
        <div class="pl-grid"></div>
      </div>
      <div class="pl-inner">
        <div class="pl-brand">{site.name}<span>.</span></div>
        <div class="pl-bar"><span id="pl-fill" class="pl-fill"></span></div>
        <div class="pl-count"><span id="pl-num">0</span>%</div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var pre = document.getElementById('preloader');
        if (!pre) return;
        var num = document.getElementById('pl-num');
        var fill = document.getElementById('pl-fill');
        var html = document.documentElement;

        function finish() {
          html.style.overflow = '';
          try { window.dispatchEvent(new Event('preloader:done')); } catch (e) {}
          pre.classList.add('is-done');
          setTimeout(function () { if (pre && pre.parentNode) pre.parentNode.removeChild(pre); }, 1000);
        }

        // Only show the loader on the first page of a session.
        try {
          if (sessionStorage.getItem('pl-seen')) {
            pre.parentNode.removeChild(pre);
            try { window.dispatchEvent(new Event('preloader:done')); } catch (e) {}
            return;
          }
          sessionStorage.setItem('pl-seen', '1');
        } catch (e) {}

        html.style.overflow = 'hidden';

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          if (num) num.textContent = '100';
          if (fill) fill.style.width = '100%';
          window.addEventListener('load', finish);
          setTimeout(finish, 1200);
          return;
        }

        var pct = 0;
        var loaded = false;
        var t0 = performance.now();
        var MIN = 1100; // minimum visible time (ms)
        window.addEventListener('load', function () { loaded = true; });

        function set(v) {
          pct = v;
          if (num) num.textContent = String(Math.round(v));
          if (fill) fill.style.width = v + '%';
        }
        function tick() {
          var elapsed = performance.now() - t0;
          var cap = loaded && elapsed > MIN ? 100 : Math.min(92, (elapsed / MIN) * 92);
          pct += (cap - pct) * 0.09;
          if (cap === 100 && 100 - pct < 0.5) pct = 100;
          set(pct);
          if (pct >= 99.6 && loaded) { set(100); finish(); return; }
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        // Safety: never hang.
        setTimeout(function () { if (!pre.classList.contains('is-done')) finish(); }, 6000);
      })();
    </script>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-black">Skip to content</a>
    <Nav />
    <div class="page-content">
      <slot />
    </div>
    <Footer />
    <WhatsAppButton />
    <ScrollToTop />
    <CustomCursor />
    <ScrollFX />
  </body>
</html>
