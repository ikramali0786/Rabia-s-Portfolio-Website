<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  gsap.registerPlugin(ScrollTrigger);

  if (reduce) {
    document.querySelectorAll('.reveal, [data-reveal]').forEach((el) => {
      (el as HTMLElement).style.opacity = '1';
    });
  } else {
    // ---- Smooth scrolling through GSAP's ticker so ScrollTrigger stays in sync ----
    const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
    (window as any).__lenis = lenis;
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // ---- Smooth in-page anchor navigation ----
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      const href = a.getAttribute('href');
      if (!href || href === '#') return;
      a.addEventListener('click', (e) => {
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -72 });
      });
    });

    // ---- Reveal helper: smooth fade + rise, plays once, never gets stuck ----
    // Using fromTo (immediateRender) so elements are hidden only by JS; if JS fails
    // they stay visible. `once: true` + ScrollTrigger firing on already-passed
    // elements at load guarantees nothing stays stuck hidden after a mid-page reload.
    const revealOne = (
      el: Element,
      opts: { y?: number; scale?: number; duration?: number; delay?: number; ease?: string } = {},
    ) => {
      gsap.fromTo(
        el,
        { y: opts.y ?? 28, opacity: 0, scale: opts.scale ?? 1 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: opts.duration ?? 0.7,
          ease: opts.ease ?? 'power3.out',
          delay: opts.delay ?? 0,
          // Clear the inline transform once done so hover / md:scale on cards still work.
          clearProps: 'transform,willChange',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        },
      );
    };

    // Headings: a touch more travel + duration for emphasis (no scale — keeps type crisp).
    document.querySelectorAll<HTMLElement>('[data-reveal="heading"]').forEach((el) => {
      revealOne(el, { y: 42, duration: 0.95 });
    });

    // Generic .reveal elements (incl. cards): refined rise + subtle scale-in, with a
    // smooth staggered cascade for siblings that share a parent (grids of cards).
    const items = gsap.utils.toArray<HTMLElement>('.reveal');
    items.forEach((el) => {
      const parent = el.parentElement;
      const sibs = parent ? Array.from(parent.children).filter((c) => c.classList.contains('reveal')) : [el];
      const idx = Math.max(0, sibs.indexOf(el));
      const isCard = el.tagName === 'ARTICLE' || el.tagName === 'FIGURE' || el.classList.contains('reveal-card');
      revealOne(el, {
        y: isCard ? 44 : 30,
        scale: isCard ? 0.94 : 0.985,
        duration: isCard ? 0.9 : 0.75,
        ease: isCard ? 'expo.out' : 'power3.out',
        delay: Math.min(idx, 6) * 0.1,
      });
    });

    // ---- Case-study cards ----
    const stackCards = gsap.utils.toArray<HTMLElement>('#work [data-stack]');
    if (stackCards.length) {
      if (window.matchMedia('(min-width: 768px)').matches) {
        // Desktop: sticky stacking deck. Each pinned card recedes (scale + dim) as the
        // next stacks over it; the last card recedes gently as the section scrolls away.
        stackCards.forEach((card, i) => {
          const isLast = i === stackCards.length - 1;
          const trigger = isLast
            ? card.parentElement?.parentElement // the stack container (mt-6 pb-...)
            : stackCards[i + 1].parentElement; // the next card's sticky wrapper
          if (!trigger) return;
          gsap.fromTo(
            card,
            { scale: 1, filter: 'brightness(1)' },
            {
              scale: isLast ? 0.96 : 0.9,
              filter: isLast ? 'brightness(0.78)' : 'brightness(0.5)',
              ease: 'none',
              scrollTrigger: {
                trigger,
                start: isLast ? 'bottom bottom-=15%' : 'top bottom',
                end: isLast ? 'bottom top' : 'top center',
                scrub: true,
              },
            },
          );
        });
      } else {
        // Mobile: cards aren't sticky — give them a polished staggered entrance instead.
        stackCards.forEach((card) => {
          gsap.fromTo(
            card,
            { y: 64, opacity: 0, scale: 0.9 },
            {
              y: 0,
              opacity: 1,
              scale: 1,
              duration: 0.85,
              ease: 'expo.out',
              clearProps: 'transform,willChange',
              scrollTrigger: { trigger: card, start: 'top 88%', once: true },
            },
          );
        });
      }
    }

    // ---- Subtle, smoothed parallax for decorative elements ----
    document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
      const depth = parseFloat(el.dataset.parallax || '0.15');
      gsap.to(el, {
        yPercent: -depth * 100,
        ease: 'none',
        scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
      });
    });

    // Recalculate trigger positions after fonts + lazy images settle.
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
