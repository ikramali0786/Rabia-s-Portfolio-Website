---
import Section from './Section.astro';
import Reveal from './motion/Reveal';
import Marquee from './motion/Marquee';
import { site } from '../data/site';

const testimonials = site.testimonials;

const star =
  '<svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77l-5.2 2.73.99-5.78L1.58 7.62l5.82-.85L10 1.5z"/></svg>';
// Country → ISO code for the self-hosted flag SVGs in /public/flags (covers every country
// used in the testimonials). Self-hosted so flags always render (no external CDN/CSP risk).
const flagCode: Record<string, string> = {
  'New Zealand': 'nz',
  'Colombia': 'co',
  'Netherlands': 'nl',
  'United States': 'us',
  'United Kingdom': 'gb',
  'United Arab Emirates': 'ae',
  'Canada': 'ca',
  'Australia': 'au',
};
const checkSvg =
  '<svg viewBox="0 0 12 12" fill="currentColor" class="h-3 w-3 shrink-0" aria-hidden="true"><path d="M10.28 2.28 4.5 8.06 1.72 5.28.28 6.72l4.22 4.22 7.22-7.22-1.44-1.44Z"/></svg>';
---

<Section id="testimonials" eyebrow="Testimonials" title={site.testimonialsIntro}>
  <!-- Fiverr rating chip -->
  <Reveal client:visible className="mb-10 flex">
    <a
      href={site.fiverr.profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View Rabia's Fiverr profile — ${site.fiverr.rating} rating, ${site.fiverr.reviews} reviews`}
      class="group inline-flex items-center gap-2.5 rounded-full border border-[#1DBF73]/25 bg-[#1DBF73]/8 px-4 py-2 text-sm transition hover:border-[#1DBF73]/50 hover:bg-[#1DBF73]/15"
    >
      <!-- star -->
      <svg viewBox="0 0 20 20" fill="#1DBF73" class="h-4 w-4 shrink-0" aria-hidden="true">
        <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77l-5.2 2.73.99-5.78L1.58 7.62l5.82-.85L10 1.5z"/>
      </svg>
      <span class="font-semibold text-white">{site.fiverr.rating}</span>
      <span class="text-white/55">&mdash; {site.fiverr.reviews} reviews on</span>
      <span class="font-semibold" style="color:#1DBF73;">Fiverr</span>
      <!-- external link arrow -->
      <svg viewBox="0 0 12 12" fill="currentColor" class="h-3 w-3 text-white/30 transition group-hover:text-[#1DBF73]" aria-hidden="true">
        <path d="M6.5 1H11v4.5M11 1 5 7M2 3H1v8h8V9"/>
      </svg>
    </a>
  </Reveal>

  <!-- Scrolling marquee of review cards (Framer Motion island) -->
  <!-- The outer wrapper applies edge-fade masks; Marquee handles the animation -->
  <Reveal client:visible>
    <Marquee client:visible duration={40} className="testimonials-outer">
      {testimonials.map((t) => (
        <figure class="flex min-h-[17rem] flex-col w-[320px] sm:w-[360px] shrink-0 rounded-3xl glass p-6 transition duration-300 hover:-translate-y-0.5">
          <div class="flex gap-1 text-amber-300" aria-label={`${t.rating} out of 5`}>
            {Array.from({ length: t.rating }).map(() => <Fragment set:html={star} />)}
          </div>
          <blockquote class="mt-4 line-clamp-4 text-base leading-relaxed text-white/85">{t.quote}</blockquote>
          <figcaption class="mt-auto pt-5 flex items-center gap-3">
            <img src={t.avatar} alt={t.author} width="44" height="44" loading="lazy" decoding="async" class="h-11 w-11 rounded-full object-cover ring-1 ring-white/15" />
            <div>
              <div class="flex items-center gap-2">
                <div class="text-sm font-semibold">{t.author}</div>
                {t.repeat && (
                  <span class="rounded-full border border-white/15 px-2 py-0.5 text-[10px] uppercase tracking-wide text-white/50">Repeat client</span>
                )}
              </div>
              <div class="mt-0.5 flex items-center gap-1.5 text-xs text-white/50">
                {flagCode[t.country] && (
                  <img src={`/flags/${flagCode[t.country]}.svg`} alt="" width="18" height="13" loading="lazy" decoding="async" class="h-3 w-auto shrink-0 rounded-[2px] ring-1 ring-white/10" />
                )}
                {t.country}
              </div>
              <div class="mt-1 flex items-center gap-1 text-xs font-medium" style="color:#1DBF73;">
                <Fragment set:html={checkSvg} />Verified Fiverr review
              </div>
            </div>
          </figcaption>
        </figure>
      ))}
    </Marquee>
  </Reveal>
</Section>

<style>
  /* Edge-fade masks + scrollbar hiding (used by the Marquee outer wrapper) */
  :global(.testimonials-outer) {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  :global(.testimonials-outer::-webkit-scrollbar) { display: none; }
</style>
