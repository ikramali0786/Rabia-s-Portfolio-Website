---
import Section from './Section.astro';
import { site } from '../data/site';

const testimonials = site.testimonials;
// Duplicate the list for a seamless loop: translate3d(0) → translate3d(-50%)
const looped = [...testimonials, ...testimonials];

const star =
  '<svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77l-5.2 2.73.99-5.78L1.58 7.62l5.82-.85L10 1.5z"/></svg>';
const globeSvg =
  '<svg viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3 shrink-0 opacity-60" aria-hidden="true"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm4.73 4.5h-1.8a7.7 7.7 0 0 0-.97-2.35A5.51 5.51 0 0 1 12.73 5.5ZM8 2.52c.67.74 1.2 1.83 1.5 2.98H6.5C6.8 4.35 7.33 3.26 8 2.52ZM2.62 9a5.46 5.46 0 0 1 0-2h2.07a10.2 10.2 0 0 0 0 2H2.62Zm.65 1.5h1.8c.22.84.55 1.64.97 2.35A5.51 5.51 0 0 1 3.27 10.5Zm1.8-5h-1.8A5.51 5.51 0 0 1 5.04 3.15 7.7 7.7 0 0 0 5.07 5.5ZM8 13.48c-.67-.74-1.2-1.83-1.5-2.98h3c-.3 1.15-.83 2.24-1.5 2.98ZM9.69 9H6.31a9.16 9.16 0 0 1 0-2h3.38a9.16 9.16 0 0 1 0 2Zm.19 3.85a7.7 7.7 0 0 0 .97-2.35h1.8a5.51 5.51 0 0 1-2.77 2.35ZM11.31 9a10.2 10.2 0 0 0 0-2h2.07a5.46 5.46 0 0 1 0 2h-2.07Z"/></svg>';
const checkSvg =
  '<svg viewBox="0 0 12 12" fill="currentColor" class="h-3 w-3 shrink-0" aria-hidden="true"><path d="M10.28 2.28 4.5 8.06 1.72 5.28.28 6.72l4.22 4.22 7.22-7.22-1.44-1.44Z"/></svg>';
---

<Section id="testimonials" eyebrow="Testimonials" title={site.testimonialsIntro}>
  <!-- Fiverr rating chip -->
  <div class="reveal mb-10 flex">
    <a
      href={site.fiverr.profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View Rabia's Fiverr profile — ${site.fiverr.rating} rating, ${site.fiverr.reviews} reviews`}
      class="group inline-flex items-center gap-2.5 rounded-full border border-[#1DBF73]/25 bg-[#1DBF73]/8 px-4 py-2 text-sm transition hover:border-[#1DBF73]/50 hover:bg-[#1DBF73]/15"
    >
      <!-- star -->
      <svg viewBox="0 0 20 20" fill="#1DBF73" class="h-4 w-4 shrink-0" aria-hidden="true">
        <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.77l-5.2 2.73.99-5.78L1.58 7.62l5.82-.85L10 1.5z"/>
      </svg>
      <span class="font-semibold text-white">{site.fiverr.rating}</span>
      <span class="text-white/55">&mdash; {site.fiverr.reviews} reviews on</span>
      <span class="font-semibold" style="color:#1DBF73;">Fiverr</span>
      <!-- external link arrow -->
      <svg viewBox="0 0 12 12" fill="currentColor" class="h-3 w-3 text-white/30 transition group-hover:text-[#1DBF73]" aria-hidden="true">
        <path d="M6.5 1H11v4.5M11 1 5 7M2 3H1v8h8V9"/>
      </svg>
    </a>
  </div>

  <!-- Scrolling marquee of review cards -->
  <!-- The outer wrapper clips overflow and applies edge-fade masks -->
  <div
    class="reveal testimonials-outer group relative overflow-x-auto"
    style="-webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);"
  >
    <!-- Scrolling track: first copy is real content, second is aria-hidden duplicate for seamless loop -->
    <div class="testimonials-track flex w-max gap-5 py-2">
      <!-- First copy — real, accessible content -->
      {testimonials.map((t) => (
        <figure class="w-[320px] sm:w-[360px] shrink-0 rounded-3xl border border-white/10 bg-ink-soft p-6 transition duration-300 hover:-translate-y-0.5 hover:border-white/25">
          <div class="flex gap-1 text-amber-300" aria-label={`${t.rating} out of 5`}>
            {Array.from({ length: t.rating }).map(() => <Fragment set:html={star} />)}
          </div>
          <blockquote class="mt-4 line-clamp-4 text-base leading-relaxed text-white/85">{t.quote}</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <img src={t.avatar} alt={t.author} width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full object-cover ring-1 ring-white/15" />
            <div>
              <div class="text-sm font-semibold">{t.author}</div>
              <div class="mt-0.5 flex items-center gap-1 text-xs text-white/50">
                <Fragment set:html={globeSvg} />{t.country}
              </div>
              <div class="mt-1 flex items-center gap-1 text-xs font-medium" style="color:#1DBF73;">
                <Fragment set:html={checkSvg} />Verified Fiverr review
              </div>
            </div>
          </figcaption>
        </figure>
      ))}

      <!-- Second copy — aria-hidden, purely visual for the seamless loop -->
      <div aria-hidden="true" class="contents">
        {testimonials.map((t) => (
          <figure class="w-[320px] sm:w-[360px] shrink-0 rounded-3xl border border-white/10 bg-ink-soft p-6 transition duration-300 hover:-translate-y-0.5 hover:border-white/25">
            <div class="flex gap-1 text-amber-300">
              {Array.from({ length: t.rating }).map(() => <Fragment set:html={star} />)}
            </div>
            <blockquote class="mt-4 line-clamp-4 text-base leading-relaxed text-white/85">{t.quote}</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <img src={t.avatar} alt="" width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full object-cover ring-1 ring-white/15" />
              <div>
                <div class="text-sm font-semibold">{t.author}</div>
                <div class="mt-0.5 flex items-center gap-1 text-xs text-white/50">
                  <Fragment set:html={globeSvg} />{t.country}
                </div>
                <div class="mt-1 flex items-center gap-1 text-xs font-medium" style="color:#1DBF73;">
                  <Fragment set:html={checkSvg} />Verified Fiverr review
                </div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  @keyframes testimonial-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .testimonials-track {
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
    animation: testimonial-scroll 40s linear infinite;
  }

  /* Pause on hover (group on the outer div) */
  .testimonials-outer:hover .testimonials-track {
    animation-play-state: paused;
  }

  /* Reduced motion: disable auto-scroll, let users scroll manually */
  @media (prefers-reduced-motion: reduce) {
    .testimonials-track {
      animation: none !important;
      transform: translateX(0) !important;
    }
  }
</style>
