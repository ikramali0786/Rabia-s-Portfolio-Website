---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
}
const { id, eyebrow, title } = Astro.props;
---
<section id={id} aria-label={title ?? eyebrow} class="relative mx-auto max-w-7xl px-6 py-24 md:py-32">
  {eyebrow && <p class="reveal mb-3 text-sm font-medium uppercase tracking-[0.2em] text-white/50">{eyebrow}</p>}
  {title && <h2 data-reveal="heading" class="max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-6xl">{title}</h2>}
  <div class="mt-12"><slot /></div>
</section>
