---
import Reveal from './motion/Reveal';
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
}
const { id, eyebrow, title } = Astro.props;
---
<section id={id} aria-label={title ?? eyebrow} class="relative mx-auto max-w-7xl px-6 py-16 sm:py-20 md:py-24">
  {eyebrow && (
    <Reveal client:visible className="mb-3">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/50 sm:text-sm">{eyebrow}</p>
    </Reveal>
  )}
  {title && (
    <Reveal client:visible y={40} duration={0.95}>
      <h2 class="max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-6xl">{title}</h2>
    </Reveal>
  )}
  <div class="mt-8 sm:mt-10 md:mt-12"><slot /></div>
</section>
