---
import Section from './Section.astro';
import WorkDeck from './motion/WorkDeck';
import { site } from '../data/site';
---
<Section id="work" eyebrow="Selected work" title={site.workIntro}>
  <!-- Sticky stacking deck: React island handles scroll-driven scale/brightness recede -->
  <WorkDeck client:load projects={site.work} />

</Section>
