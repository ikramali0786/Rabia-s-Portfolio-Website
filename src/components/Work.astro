---
import Section from './Section.astro';
import { site } from '../data/site';
---
<Section id="work" eyebrow="Selected work" title={site.workIntro}>
  <!-- Sticky stacking deck: each card pins and the next stacks over it on scroll (desktop). -->
  <div class="mt-6 pb-6 md:pb-[12vh]">
    {site.work.map((w, i) => (
      <div
        class="static mb-6 md:sticky md:mb-10"
        style={`top: calc(6rem + ${i} * 2rem); z-index: ${i + 1}`}
      >
        <article
          data-stack
          class="group grid origin-top overflow-hidden rounded-3xl border border-white/10 bg-ink-soft shadow-2xl shadow-black/60 md:grid-cols-2"
        >
          <!-- Image -->
          <div class="relative overflow-hidden md:min-h-[24rem]">
            <img
              src={w.image}
              alt={`${w.title} — ${w.industry}`}
              width="800"
              height="600"
              loading="lazy"
              class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
            />
            <div class="pointer-events-none absolute right-[-15%] top-[-15%] h-1/2 w-1/2 rounded-full opacity-25 blur-3xl iridescent"></div>
            <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-black/40 px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/70 backdrop-blur">
              Case 0{i + 1}
            </div>
          </div>

          <!-- Details -->
          <div class="flex flex-col justify-center p-7 sm:p-9 md:p-10">
            <h3 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">{w.title}</h3>
            <p class="mt-3 max-w-xl text-white/65 sm:mt-4">{w.summary}</p>

            <div class="mt-5 flex flex-wrap gap-2 sm:mt-6">
              {w.services.map((s) => (
                <span class="rounded-full border border-white/15 px-3 py-1 text-xs uppercase tracking-wide text-white/60">{s}</span>
              ))}
            </div>

            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-5 text-sm sm:mt-8 sm:pt-6">
              <div><span class="block text-white/40">Industry</span><span class="font-medium">{w.industry}</span></div>
              <div><span class="block text-white/40">Year</span><span class="font-medium">{w.year}</span></div>
              <div><span class="block text-white/40">Result</span><span class="font-medium">{w.stat}</span></div>
            </div>
          </div>
        </article>
      </div>
    ))}
  </div>
</Section>
