---
import Section from './Section.astro';
import Reveal from './motion/Reveal';
import { site } from '../data/site';

// One distinct line icon + accent per reason (index-matched to site.whyChooseMe), so the
// section reads as a set of value props rather than a flat checklist. Accents cycle the
// site's iridescent palette, matching the Services / Trust-bar icon chips.
const reasons = [
  // Shopify-focused expertise — shopping bag
  { accent: '#a78bfa', svg: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>' },
  // Mobile-first development — smartphone
  { accent: '#f472b6', svg: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>' },
  // Conversion-driven design — trending up
  { accent: '#22d3ee', svg: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>' },
  // Fast project delivery — lightning bolt
  { accent: '#fbbf24', svg: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>' },
  // Clear communication — chat bubble
  { accent: '#34d399', svg: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>' },
  // Long-term support — shield
  { accent: '#a78bfa', svg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  // Attention to detail — check circle
  { accent: '#f472b6', svg: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
  // Business-focused solutions — target
  { accent: '#22d3ee', svg: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>' },
];
---

<Section id="why-choose-me" eyebrow="Why me" title="Why Brands Choose to Work With Me">
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {site.whyChooseMe.map((item, i) => {
      const r = reasons[i % reasons.length];
      return (
        <Reveal client:visible y={32} duration={0.75} delay={Math.min(i, 7) * 0.05}>
          <li class="group flex h-full flex-col gap-4 glass rounded-2xl p-6 transition duration-300 hover:-translate-y-1">
            <span
              class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl border bg-white/[0.04] transition duration-300 group-hover:bg-white/[0.07]"
              style={`border-color:${r.accent}40; box-shadow:0 0 28px -12px ${r.accent};`}
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke={r.accent} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={r.svg}></svg>
            </span>
            <span class="text-base font-semibold leading-snug text-white/90">{item}</span>
          </li>
        </Reveal>
      );
    })}
  </ul>
</Section>
