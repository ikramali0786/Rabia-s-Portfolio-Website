---
import Section from './Section.astro';
import { site } from '../data/site';

const checkSvg =
  '<svg viewBox="0 0 12 12" fill="currentColor" class="h-3.5 w-3.5 shrink-0 mt-0.5 text-amber-300" aria-hidden="true"><path d="M10.28 2.28 4.5 8.06 1.72 5.28.28 6.72l4.22 4.22 7.22-7.22-1.44-1.44Z"/></svg>';
---

<Section id="pricing" eyebrow="Pricing" title={site.pricing.intro}>
  <div class="grid gap-6 md:grid-cols-3">
    {site.pricing.tiers.map((tier) => (
      <article
        class:list={[
          'reveal relative flex flex-col rounded-3xl border p-8 transition-all duration-300',
          'bg-[--color-ink-soft]',
          tier.featured
            ? 'border-white/30 md:-mt-4 md:scale-[1.03]'
            : 'border-white/10 hover:border-white/20',
        ]}
      >
        {/* Iridescent top-edge glow on featured */}
        {tier.featured && (
          <div
            class="pointer-events-none absolute inset-x-0 -top-px h-px iridescent opacity-80"
            aria-hidden="true"
          />
        )}

        {/* "Most popular" badge */}
        {tier.featured && (
          <div class="mb-5 flex">
            <span class="iridescent rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-widest text-white">
              Most popular
            </span>
          </div>
        )}

        {/* Tier name */}
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/50">{tier.name}</p>

        {/* Price */}
        <div class="mt-3 flex items-end gap-2">
          <span
            class:list={[
              'text-5xl font-extrabold leading-none tracking-tight',
              tier.featured ? 'iridescent-text' : 'text-white',
            ]}
          >
            {tier.price}
          </span>
          <span class="mb-1 text-sm text-white/45">{tier.cadence}</span>
        </div>

        {/* Description */}
        <p class="mt-4 text-sm leading-relaxed text-white/60">{tier.description}</p>

        {/* Divider */}
        <div class="my-6 h-px bg-white/10" />

        {/* Features */}
        <ul class="flex flex-col gap-3" role="list">
          {tier.features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm text-white/80">
              <Fragment set:html={checkSvg} />
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        {/* CTA */}
        <div class="mt-8">
          <a
            href="#contact"
            class:list={[
              'btn w-full px-6 py-3 text-center',
              tier.featured ? 'btn-primary' : 'btn-secondary',
            ]}
          >
            {tier.cta}
          </a>
        </div>
      </article>
    ))}
  </div>

  {/* Disclaimer note */}
  <p class="mt-10 text-center text-sm text-white/40">{site.pricing.note}</p>
</Section>
