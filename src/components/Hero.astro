---
import Reveal from './motion/Reveal';
import Parallax from './motion/Parallax';
import { site } from '../data/site';
const trust = site.stats.slice(0, 3);
---
<section aria-label="Introduction" class="relative overflow-hidden px-6 pb-20 pt-32 sm:pt-36 md:pt-44">
  <!-- Backdrop: dotted grid + layered iridescent orbs -->
  <div class="pointer-events-none absolute inset-0 grid-backdrop"></div>
  <div class="pointer-events-none absolute right-[-12%] top-[8%] h-[55vh] w-[55vh] rounded-full opacity-40 blur-3xl iridescent iridescent-float"></div>
  <div class="pointer-events-none absolute right-[18%] bottom-[6%] h-[28vh] w-[28vh] rounded-full opacity-25 blur-3xl iridescent iridescent-float-slower"></div>
  <Parallax client:visible depth={0.18} className="pointer-events-none absolute left-[-10%] top-[30%] h-[26vh] w-[26vh] rounded-full opacity-15 blur-3xl iridescent" />

  <div class="relative mx-auto w-full max-w-7xl">
    <!-- Availability badge -->
    <Reveal client:visible>
      <div class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/75 backdrop-blur">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {site.hero.badge}
      </div>
    </Reveal>

    <Reveal client:visible y={40} duration={0.95} delay={0.05}>
      <h1 class="mt-6 max-w-5xl text-[2.5rem] font-black leading-[1.04] tracking-tight sm:text-5xl md:text-7xl">
        {site.hero.titleStart}<span class="iridescent-text">{site.hero.titleHighlight}</span>{site.hero.titleEnd}
      </h1>
    </Reveal>

    <Reveal client:visible delay={0.1}>
      <p class="mt-5 max-w-2xl text-lg text-white/65 md:text-xl">{site.hero.subtitle}</p>
    </Reveal>

    <Reveal client:visible delay={0.15}>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#work" class="group btn btn-primary px-7 py-3.5">
          View work <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
        <a href="#contact" class="btn btn-secondary px-7 py-3.5">Get in touch</a>
      </div>
    </Reveal>

    <!-- Inline trust stats -->
    <Reveal client:visible delay={0.2}>
      <dl class="mt-8 grid grid-cols-3 gap-3 border-t border-white/10 pt-7 sm:mt-10 sm:flex sm:flex-wrap sm:gap-x-10 sm:gap-y-6 sm:pt-8">
        {trust.map((s) => (
          <div>
            <dt class="text-2xl font-black tracking-tight sm:text-3xl md:text-4xl">{s.value}</dt>
            <dd class="mt-1 text-[11px] leading-tight text-white/50 sm:text-sm">{s.label}</dd>
          </div>
        ))}
      </dl>
    </Reveal>
  </div>
</section>
