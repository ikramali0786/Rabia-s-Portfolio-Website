---
import { site } from '../data/site';

const path = Astro.url.pathname;
const onHome = path === '/';
const anchor = (href: string) => (href.startsWith('#') && !onHome ? `/${href}` : href);
---
<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:py-5">
    <a href={onHome ? '#top' : '/'} class="text-lg font-extrabold tracking-tight">{site.name}<span class="text-white/40">.</span></a>
    <div class="hidden items-center gap-8 md:flex">
      {site.nav.map((n) => <a href={anchor(n.href)} class="text-sm text-white/70 transition hover:text-white">{n.label}</a>)}
      <a href={site.bookingUrl} class="btn btn-primary px-5 py-2 text-sm">Book a call</a>
    </div>
    <button
      id="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      class="-mr-1.5 flex h-10 w-10 flex-col items-center justify-center gap-[5px] rounded-full border border-white/10 bg-white/5 backdrop-blur transition hover:bg-white/10 md:hidden"
    >
      <span class="h-0.5 w-5 rounded-full bg-white"></span>
      <span class="h-0.5 w-5 rounded-full bg-white"></span>
      <span class="h-0.5 w-5 rounded-full bg-white"></span>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="mobile-overlay"
    class="pointer-events-none fixed inset-0 z-[80] bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:hidden"
  ></div>
  <aside
    id="mobile-drawer"
    aria-hidden="true"
    class="fixed right-0 top-0 z-[90] flex h-full w-72 max-w-[82vw] translate-x-full flex-col border-l border-white/10 bg-[#121218] p-6 shadow-2xl shadow-black/70 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] md:hidden"
  >
    <div class="flex items-center justify-between">
      <span class="text-lg font-extrabold tracking-tight">{site.name}<span class="text-white/40">.</span></span>
      <button id="nav-close" aria-label="Close menu" class="grid h-9 w-9 place-items-center rounded-full border border-white/10 text-white/70 transition hover:bg-white/10 hover:text-white">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <nav class="mt-8 flex flex-col">
      {site.nav.map((n) => (
        <a href={anchor(n.href)} class="mobile-link border-b border-white/5 py-3.5 text-lg font-medium text-white/80 transition hover:text-white">{n.label}</a>
      ))}
    </nav>

    <a href={site.bookingUrl} class="mobile-link btn btn-primary mt-6 w-full px-5 py-3 text-center text-base">Book a call</a>

    <div class="mobile-socials mt-auto flex gap-3 pt-8">
      {site.socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel="noopener noreferrer"
          aria-label={s.label}
          class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/70 transition hover:border-white/30 hover:text-white"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.icon}/></svg>
        </a>
      ))}
    </div>
  </aside>
</header>

<style>
  /* Mobile drawer: staggered link reveal */
  #mobile-drawer .mobile-link {
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-drawer.is-open .mobile-link {
    opacity: 1;
    transform: translateX(0);
  }
  #mobile-drawer.is-open .mobile-link:nth-child(1) { transition-delay: 0.10s; }
  #mobile-drawer.is-open .mobile-link:nth-child(2) { transition-delay: 0.16s; }
  #mobile-drawer.is-open .mobile-link:nth-child(3) { transition-delay: 0.22s; }
  #mobile-drawer.is-open .mobile-link:nth-child(4) { transition-delay: 0.28s; }
  #mobile-drawer.is-open .mobile-link:nth-child(5) { transition-delay: 0.34s; }
  #mobile-drawer.is-open .mobile-link:nth-child(6) { transition-delay: 0.40s; }
  #mobile-drawer.is-open .mobile-link:nth-child(7) { transition-delay: 0.46s; }
  #mobile-drawer.is-open .mobile-link:nth-child(8) { transition-delay: 0.52s; }

  /* Socials block stagger (last item after the CTA) */
  #mobile-drawer .mobile-socials {
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.58s;
  }
  #mobile-drawer.is-open .mobile-socials {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('nav-close');
  const overlay = document.getElementById('mobile-overlay');
  const drawer = document.getElementById('mobile-drawer');

  const onScroll = () => {
    const solid = window.scrollY > 24;
    nav?.classList.toggle('bg-black/80', solid);
    nav?.classList.toggle('backdrop-blur', solid);
    nav?.classList.toggle('border-b', solid);
    nav?.classList.toggle('border-white/10', solid);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const lenis = () => (window as any).__lenis;

  const setOpen = (open: boolean) => {
    drawer?.classList.toggle('translate-x-full', !open);
    overlay?.classList.toggle('opacity-0', !open);
    overlay?.classList.toggle('pointer-events-none', !open);
    drawer?.setAttribute('aria-hidden', String(!open));
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      drawer?.classList.add('is-open');
      lenis()?.stop();
    } else {
      drawer?.classList.remove('is-open');
      lenis()?.start();
    }
  };

  toggle?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  overlay?.addEventListener('click', () => setOpen(false));
  document.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('translate-x-full')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
