---
import Reveal from './motion/Reveal';
import { site } from '../data/site';

// Accent colours cycling the site palette: violet → pink → cyan → amber
const accents = ['#a78bfa', '#f472b6', '#22d3ee', '#fbbf24'] as const;

// Clean line-icon SVG paths — one per trust item in order
const icons = [
  // Lightning bolt — Fast & Optimized Stores
  '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
  // Trending up — Conversion-Focused Design
  '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  // Shopping bag — Shopify Expert
  '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  // Globe — Remote Freelancer
  '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
] as const;
---

<section aria-label="Why clients trust me" class="py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {site.trust.map((item, i) => {
        const accent = accents[i % accents.length];
        const icon  = icons[i % icons.length];
        return (
          <Reveal client:visible y={32} duration={0.75} delay={i * 0.06}>
            <div class="group glass rounded-2xl p-6 text-center transition duration-300 hover:-translate-y-1 flex flex-col items-center gap-4">
              {/* Accent icon chip */}
              <div
                class="grid h-12 w-12 place-items-center rounded-2xl border border-white/10 bg-white/[0.04] transition duration-300 group-hover:bg-white/[0.07]"
                style={`border-color:${accent}40; box-shadow:0 0 28px -10px ${accent}`}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="none"
                  stroke={accent}
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icon}
                ></svg>
              </div>
              {/* Label */}
              <p class="text-sm font-semibold leading-snug tracking-tight text-white/85">{item.label}</p>
            </div>
          </Reveal>
        );
      })}
    </div>
  </div>
</section>
