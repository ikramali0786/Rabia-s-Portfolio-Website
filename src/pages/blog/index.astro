---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.name} Blog`,
  url: `${site.url}/blog`,
  description: 'Practical articles on Shopify development, performance, migration, and conversion — written from the trenches.',
};
---
<BaseLayout
  title={`Blog — ${site.name}`}
  description="Articles on Shopify development, migration, speed and CRO."
  canonicalUrl={`${site.url}/blog`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogLd)} />
  </Fragment>
  <main id="main-content" class="pt-32 pb-24 md:pb-32">
    <div class="mx-auto max-w-7xl px-6">
      <!-- Header -->
      <div class="mb-16">
        <p class="reveal mb-3 text-sm font-medium uppercase tracking-[0.2em] text-white/50">Blog</p>
        <h1 data-reveal="heading" class="max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-6xl">
          Insights on Shopify
        </h1>
        <p class="reveal mt-6 max-w-xl text-lg text-white/60">
          Practical articles on Shopify development, performance, migration, and conversion — written from the trenches.
        </p>
      </div>

      <!-- Posts grid -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="reveal group flex flex-col rounded-3xl border border-white/10 bg-[--color-ink-soft] p-8 transition-all duration-300 hover:border-white/25 hover:bg-white/5"
          >
            <div class="mb-4 flex flex-wrap gap-2">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-white/50">
                  {tag}
                </span>
              ))}
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class="mb-3 text-xs uppercase tracking-widest text-white/40"
            >
              {formatDate(post.data.date)}
            </time>
            <h2 class="mb-3 text-xl font-bold leading-snug tracking-tight transition-colors group-hover:text-white/90">
              {post.data.title}
            </h2>
            <p class="flex-1 text-sm leading-relaxed text-white/55">
              {post.data.description}
            </p>
            <span class="mt-6 text-sm font-semibold text-white/70 transition group-hover:text-white">
              Read →
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
